# Copie para deploy/.env (o instalar.sh faz isso e gera as senhas). Nunca vai para o git.
DB_PASSWORD=
APP_URL=https://app.DOMINIO-DA-DORS
# Endereço público da Central de clientes (domínio próprio, separado do sistema).
BACKOFFICE_URL=https://painel.DOMINIO-DA-DORS
CRON_SECRET=
# Segredo das rotas /api/ops (o backoffice usa); gerado pelo instalador.
OPS_SECRET=
BACKOFFICE_SECRET=
# Código para criar o PRIMEIRO administrador da Central de clientes (entregue à DOR$ uma vez).
BACKOFFICE_SETUP_KEY=
# Instalação nova: pode ser gerado (openssl rand -hex 32). Se for copiar o banco do sistema antigo, o valor de lá TEM de ser o mesmo:
# ele cifra as senhas guardadas no banco. Se mudar, nada decifra.
SESSION_SECRET=
EDGES_API_KEY=
EDGES_WEBHOOK_SECRET=
NOUS_API_KEY=
ELEVENLABS_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:EMAIL-DA-DORS
SERPAPI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deskcomm da DOR$ (mesma VPS): um só endereço para todos os clientes; a chave de cada cliente é gravada no sistema (cifrada) pelo backoffice.
DESKCOMM_URL=https://crm.DOMINIO-DA-DORS
DESKCOMM_WEBHOOK_SECRET=
