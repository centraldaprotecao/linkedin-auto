# MODELO do .env do Deskcomm (CRM de WhatsApp) para a VPS da DOR$.
# Gerado a partir da configuração do Deskcomm atual do Lucas (valores secretos NÃO copiados; domínio e e-mails trocados).
# Linhas "GERAR NOVO": crie um valor novo (openssl rand -hex 32) ou pegue no Supabase/OpenRouter da DOR$.
# Decisões já tomadas: Sentry desligado (SENTRY_DSN vazio), sem Resend/OpenAI, voz/telefonia desligadas (COMPOSE_PROFILES vazio),
# engine do WhatsApp NOWEB, imagens fixas (worker/scheduler 1.69.0, WAHA latest-2026.7.2), app = fork do Lucas gerado no GitHub da DOR$.
# O fork tem 26 mudanças sobre o Deskcomm oficial; sem ele o sistema não conecta por QR nem lê histórico com mídia.
# ATENÇÃO: troque APP_IMAGE pela imagem gerada na conta da DOR$ (ghcr.io/<usuario-da-dors>/deskcommcrm:fork-latest).
# Gerado por install.sh — NÃO comitar. Contém segredos.
APP_IMAGE="ghcr.io/lucasprestestec/deskcommcrm:fork-latest"
APP_PULL_POLICY="missing"
WORKER_IMAGE="ghcr.io/melgarafael/deskcomm-worker:1.69.0"
WORKER_PULL_POLICY="missing"
SCHEDULER_IMAGE="ghcr.io/melgarafael/deskcomm-scheduler:1.69.0"
SCHEDULER_PULL_POLICY="missing"
VOICE_AGENT_IMAGE="ghcr.io/melgarafael/deskcomm-voice-agent:1.69.0"
VOICE_AGENT_PULL_POLICY="missing"
DOMAIN="crm.DOMINIO-DA-DORS"
ACME_EMAIL="administrativo@dorsplanejamento.com.br"
# Proxy reverso: "caddy" (o kit sobe o dele nas portas 80/443), "traefik"
# (o VPS já tem um Traefik nessas portas — Hostinger, Coolify, Dokploy...)
# ou "npm" (Nginx Proxy Manager, que não lê labels — ver o cabeçalho de
# docker-compose.npm.yml). Em "traefik" entra o docker-compose.traefik.yml,
# que desliga o Caddy e publica o app por labels (TRAEFIK_* só é lido nesse
# modo). Em "npm" entra o docker-compose.npm.yml, que também desliga o Caddy
# e fixa o app na rede/IP que o Proxy Host espera (PROXY_NETWORK_* só é lido
# nesse modo, e é sempre configuração manual — não há como detectar o NPM
# sozinho, ao contrário do Traefik).
REVERSE_PROXY="caddy"
TRAEFIK_NETWORK="traefik"
TRAEFIK_ENTRYPOINT_HTTP="web"
TRAEFIK_ENTRYPOINT="websecure"
TRAEFIK_CERTRESOLVER="letsencrypt"
NEXT_PUBLIC_SUPABASE_URL=   # URL do projeto Supabase NOVO da DOR$
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # painel do Supabase da DOR$ › Project Settings › API (anon)
SUPABASE_SERVICE_ROLE_KEY=   # painel do Supabase da DOR$ › Project Settings › API (service_role). SEGREDO
SUPABASE_DB_URL=   # painel do Supabase da DOR$ › Connect › conexão direta (ou session pooler). SEGREDO
SINGLE_SERVER="0"
SINGLE_SERVER_NETWORK=""
PSQL_DOCKER_NETWORK=""
SUPABASE_INTERNAL_URL=""
NEXT_PUBLIC_APP_URL="https://crm.DOMINIO-DA-DORS"
NEXT_PUBLIC_ADMIN_URL="https://crm.DOMINIO-DA-DORS"
# Marca da instalação (white-label). Preencha APP_LOGO_URL com a URL de uma
# imagem pública para trocar o texto por logo na sidebar. Ver lib/branding.ts.
# APP_ACCENT_HEX é a SEMENTE da cor: o banco (platform_branding) manda depois
# da primeira leitura. Nos e-mails de acesso depende da topologia: na NUVEM do
# Supabase quem empurra é o marca-emails.sh, lendo daqui, e o banco não alcança;
# num Supabase PRÓPRIO o GoTrue busca /email-templates/ do app, que resolve a
# marca pelo banco — e aí trocar em Configurações > Marca chega ao e-mail.
APP_NAME="DOR$"
APP_LOCALE="pt-BR"
DESKCOMM_IDIOMA_CLI="pt-BR"
APP_LOGO_URL=""
APP_ACCENT_HEX=""
# Endereço de suporte que o CLIENTE FINAL vê (conta suspensa, cobrança).
# Vazio = a tela não mostra endereço nenhum.
SUPPORT_EMAIL="administrativo@dorsplanejamento.com.br"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""   # vazio de propósito (não usado na instalação da DOR$)
# E-mail transacional. RESEND_FROM_EMAIL tem de ser de um domínio
# VERIFICADO na SUA conta Resend. Vazio = e-mail desligado: o convite
# mostra o link de aceite na tela e o export de LGPD fica pendente.
RESEND_API_KEY=""   # vazio de propósito (não usado na instalação da DOR$)
RESEND_FROM_EMAIL=""
# E-mail pelo SEU servidor (SMTP). Preenchido, sai por ele; vazio, segue
# pela Resend. Só o hostname. 465 + tls, ou 587 + starttls.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURITY="starttls"
SMTP_USERNAME=""
SMTP_PASSWORD=""   # vazio de propósito (não usado na instalação da DOR$)
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=""
# Qual provedor você escolheu na instalação. É o que faz a 2ª execução do
# install.sh já vir com a sua escolha como padrão, em vez de re-adivinhar
# pelas chaves presentes. A app não lê esta variável.
AI_PROVIDER="openrouter"
ANTHROPIC_API_KEY=""   # vazio de propósito (não usado na instalação da DOR$)
AI_GATEWAY_API_KEY=""   # vazio de propósito (não usado na instalação da DOR$)
# OpenRouter: alternativa ao AI Gateway para o chat da IA. A ordem de
# resolução é AI_GATEWAY_API_KEY > OPENROUTER_API_KEY > provider direto,
# então deixar vazio NÃO muda nada — o comportamento de hoje continua.
# BASE_URL vazia = https://openrouter.ai/api/v1 (só mude se usa proxy).
OPENROUTER_API_KEY=   # chave "CRM" do OpenRouter da DOR$ (bloco 6 do guia)
OPENROUTER_BASE_URL=""
# OpenAI: transcrição dos áudios do WhatsApp (Whisper) + embeddings do RAG.
# Opcional — sem ela a IA responde sem a base e pede o áudio em texto.
OPENAI_API_KEY=""   # vazio de propósito (não usado na instalação da DOR$)
# Web Push: aviso na bandeja do sistema com a aba do CRM fechada.
# Opcional e VAZIO por padrão — sem o par, os avisos aparecem só com o
# site aberto, que é exatamente o que acontecia antes. Para ligar:
#   npx web-push generate-vapid-keys
# e cole as duas chaves aqui (depois: docker compose up -d app).
VAPID_PUBLIC_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
VAPID_PRIVATE_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
# Provisionamento por sistema externo (POST /api/v1/tenants/provision):
# um sistema de fora cria empresas nesta instalação. DESLIGADO — vazio, a
# rota responde 404. Para ligar: openssl rand -hex 32, cole aqui e entregue
# só ao sistema que vai criar empresas (depois: docker compose up -d app).
# Telemetria de erros (você escolheu isto durante a instalação).
#   "off"  = não envia nada.
#   vazio  = só ERRO pro Sentry da comunidade, com CPF/telefone/e-mail
#            substituídos e token de URL redigido. Sem trace, sem replay.
#   <dsn>  = manda pro SEU Sentry (aí com performance e replay).
SENTRY_DSN="off"   # decisão: Sentry desligado
INTERNAL_SECRET=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
INTERNAL_CRON_SECRET=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
CPF_ENCRYPTION_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
AI_CRED_AES_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
WAHA_BYO_ENCRYPTION_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
IMPERSONATE_COOKIE_SECRET=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
LGPD_SIGNING_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
WAHA_API_BASE_URL="http://waha:3000"
WAHA_WEBHOOK_BASE_URL="http://app:3000"
WAHA_API_KEY=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
WAHA_API_KEY_SHA512=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
WAHA_HMAC_SECRET=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
# Chamada de voz WhatsApp (spec 18) — DESLIGADA. Ligá-la vincula um SEGUNDO
# aparelho ao mesmo número que já atende, por um caminho que não é o oficial:
# o risco é a CONTA ser bloqueada. Para ligar: COMPOSE_PROFILES=voz e
# WACALLS_API_BASE_URL=http://wacalls:8080, depois ./update.sh e, na tela,
# Configurações › Segurança. Vazio = o serviço nem é criado.
COMPOSE_PROFILES=""
WACALLS_API_BASE_URL=""
WACALLS_ADMIN_USER="deskcomm"
WACALLS_ADMIN_PASSWORD=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
WACALLS_API_TOKEN=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
# "true" exige assinatura em todo webhook do WAHA. O WAHA Core NÃO assina,
# então ligar isto sem um WAHA Plus (ou proxy que assine) para a ingestão
# de mensagens. A rota global já não é publicada na internet (ver Caddyfile).
WAHA_WEBHOOK_REQUIRE_SIGNATURE="false"
# Retoma as sessões já pareadas quando o contêiner do transporte reinicia.
# Sem isto o número segue pareado no volume e MUDO até alguém abrir a tela
# e clicar Reconectar — nada entra nem sai nesse meio-tempo.
WHATSAPP_RESTART_ALL_SESSIONS="True"
WAHA_IMAGE="devlikeapro/waha:latest-2026.7.2"
WAHA_DEFAULT_ENGINE="NOWEB"
UPSTASH_REDIS_REST_URL="http://srh:80"
UPSTASH_REDIS_REST_TOKEN=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
SRH_TOKEN=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
NODE_ENV="production"
NUVEMSHOP_ENABLED="false"
INTERNAL_AGENT_RUN_STUB="false"
OWNER_EMAIL="administrativo@dorsplanejamento.com.br"
OWNER_PASSWORD=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
TENANT_PROVISIONING_ALLOW_MANAGER="true"
TENANT_PROVISIONING_SECRET=   # GERAR NOVO (segredo; não reaproveitar o do sistema antigo)
