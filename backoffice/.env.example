# Central de clientes da DOR$ (app separado do sistema). Todos os valores são gerados pelo instalador (deploy/instalar.sh).

# Banco PRÓPRIO do backoffice (administradores e registro de ações). Nunca o banco do sistema.
BACKOFFICE_DATABASE_URL=

# Assina os cookies de entrada. Gere um valor longo e aleatório (32+ caracteres).
BACKOFFICE_SECRET=

# Código de instalação: vale só para criar o PRIMEIRO administrador (some quando ele existe).
BACKOFFICE_SETUP_KEY=

# Endereço do sistema (dentro da rede do servidor) e o segredo das rotas /api/ops (OPS_SECRET do sistema).
SISTEMA_URL=http://app:3000
OPS_SECRET=

# Endereço público deste painel (para montar os links de convite dos administradores).
BACKOFFICE_URL=https://painel.exemplo.com.br
