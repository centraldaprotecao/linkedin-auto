# Variáveis do BACKOFFICE (projeto "painel" na Vercel). Os valores ficam na Vercel, nunca no git.
# Passo a passo completo: docs/instalacao-dors.md (na raiz do projeto do sistema)

# Banco: o MESMO Postgres do Supabase, mas outro esquema (backoffice). Use o pooler (porta 6543).
BACKOFFICE_DATABASE_URL=
BACKOFFICE_DB_SCHEMA=backoffice

# Assina os cookies de entrada. Valor longo e aleatório (32+ caracteres): openssl rand -hex 32
BACKOFFICE_SECRET=

# Código de instalação: vale só para criar o PRIMEIRO administrador (para de valer quando ele existe).
BACKOFFICE_SETUP_KEY=

# Endereço público do sistema (https://app.dominio.com.br) e o segredo das rotas /api/ops (o MESMO OPS_SECRET do sistema).
SISTEMA_URL=
OPS_SECRET=

# Endereço público deste painel (para montar os links de convite dos administradores).
BACKOFFICE_URL=
