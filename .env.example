# Variáveis do SISTEMA (projeto "sistema" na Vercel). Os valores ficam na Vercel (Settings › Environment Variables), nunca no git.
# Passo a passo completo: docs/instalacao-dors.md

# --- Banco (Supabase da DOR$) ---
# Conexão com pooler ("Transaction pooler", porta 6543) do usuário "sistema" (deploy/papeis-banco.sql), nunca do "postgres".
DATABASE_URL=
# Conexão direta (porta 5432), também do usuário "sistema", usada só para aplicar as migrações (npx prisma migrate deploy).
DIRECT_URL=
# O sistema mora num esquema próprio dentro do Postgres compartilhado com o Deskcomm. Não mude depois de criado.
DATABASE_SCHEMA=central
# Conexões abertas por instância do servidor (padrão 5).
# DATABASE_POOL_MAX=5

# --- Segurança (gere valores novos e longos: openssl rand -hex 32) ---
# Assina o cookie de entrada e cifra as senhas guardadas no banco (caixas de e-mail, Google, WhatsApp).
# Depois que houver dados, NÃO troque: o que está cifrado deixa de abrir.
SESSION_SECRET=
# O agendador (Vercel Cron) envia "Authorization: Bearer <CRON_SECRET>" para /api/cron/poll. Obrigatório.
CRON_SECRET=
# Segredo das rotas /api/ops/* (o backoffice usa; precisa ser o MESMO valor em OPS_SECRET do projeto "painel").
OPS_SECRET=

# --- Endereços ---
# Endereço público do sistema, sem barra no final (ex.: https://app.dominio.com.br). Usado em callbacks, links e imagem de abertura dos e-mails.
APP_URL=
# Opcional: endereço dos links de e-mail (abertura e "não quero receber") se for diferente do APP_URL (ex.: https://links.dominio.com.br).
# TRACKING_URL=

# --- LinkedIn (Edges, app.edges.run) ---
EDGES_API_KEY=
# Segredo enviado como cabeçalho "X-Webhook-Secret" nos webhooks da Edges (Developer Settings > Webhooks, URL <APP_URL>/api/webhooks/edges). Obrigatório.
EDGES_WEBHOOK_SECRET=
# Só para desenvolvimento local, sem conta conectada: identidade de teste.
# EDGES_IDENTITY_ID=

# --- IA (OpenRouter, chave "Sistema") ---
NOUS_API_KEY=
NOUS_BASE_URL=https://openrouter.ai/api/v1
# Modelos (têm padrão no código; só defina para trocar):
# NOUS_MODEL=
# NOUS_MODEL_FAST=
# NOUS_MODEL_MEDIA=

# --- Voz (ElevenLabs): vozes prontas e gravação da própria voz. Gravar a voz exige plano pago (Starter ou acima). ---
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4

# --- Busca de pessoas (use UMA) ---
SERPAPI_API_KEY=
# SERPER_API_KEY=
# WEB_SEARCH_MONTHLY_LIMIT=240

# --- Avisos no celular/computador (opcional): npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:administrativo@dorsplanejamento.com.br

# --- Google (OAuth do app: Gmail e Agenda). Redirecionamento: <APP_URL>/api/email/google/callback ---
# Publique o app no Google ("Em produção"), senão a autorização expira em 7 dias.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WhatsApp (Deskcomm) ---
# Um CRM só para todos os clientes. A chave de cada cliente (dsk_..., permissões mcp:read, mcp:write e role:manager)
# é guardada cifrada no banco pelo backoffice, não por variável.
DESKCOMM_URL=
# Aviso instantâneo de mensagem nova: no Deskcomm crie uma regra (gatilho message.received, ação "Chamar webhook") para
# <APP_URL>/api/webhooks/deskcomm com este mesmo segredo (16+ caracteres). Sem o segredo no Deskcomm, use <endereço>?token=<segredo>.
DESKCOMM_WEBHOOK_SECRET=
# Só se o link de áudio/foto/vídeo que o Deskcomm entrega apontar para um endereço interno: troca o começo do link.
# DESKCOMM_MEDIA_BASE_URL=

# Nome no "De:" dos e-mails quando a caixa não tem nome próprio.
# EMAIL_FROM_NAME=
